{
  "schema": "graft-experiment-protocol-v1",
  "status": "week1_protocol_frozen_execution_pending_type_and_surface_validation",
  "historical_outputs_policy": "read_only_evidence_never_auto_resume",
  "primary_api_universe": "publicly_named_crate_owned_function_definitions_with_body_v1; opaque/blanket review separate; no full-callable completeness claim",
  "historical_snapshot_policy": "freeze_original_APIDoc_rows_and_unique_rustdoc_definitions_separately",
  "coverage_states": [
    "graph_reachable",
    "planned",
    "retained_in_compiled_code",
    "observed_executed"
  ],
  "mapping_policy": "unique_exact_function_entry_position_v1_with_unresolved_items_retained",
  "version_tracks": {
    "historical_compatibility": "versions observed in RULF artifacts first, otherwise RPG artifacts, otherwise GRAFT; feasibility pending",
    "newer_compatibility": "versions frozen from the 13 historical GRAFT embedded rustdoc documents"
  },
  "comparison_policy": {
    "same_crate_version_and_features": true,
    "same_api_universe_sha256": true,
    "target_count_curve": [
      10,
      20,
      50,
      100
    ],
    "candidate_primary_worker_hours_per_crate": 20,
    "worker_accounting": "sum_all_workers_including_master_followers; actual_CPU_time_separately",
    "candidate_max_concurrent_physical_cores": 24,
    "affinity_and_parallelism": "explicitly_record_before_start; do_not_equate_64_threads_to_64_cores",
    "generation_budget": "request_and_token_caps_must_be_set_in_each_run_manifest",
    "seed_policy": "public_tool_independent_baseline; native_and_LLM_seeds_separate_comparisons",
    "corpus_replay": "all_available_queue_inputs_with_uniform_policy; sampling_requires_preregistered_equal_rules",
    "pilot_generation_batches": 5,
    "pilot_afl_seeds_per_batch": 3,
    "formal_repetitions": "fix_after_pilot_before_formal_runs; planned_range_10_to_20",
    "independent_run_directory": true,
    "infra_failure_policy": "record_error_and_original_run; rerun_only_preregistered_infrastructure_failures",
    "tool_failures": "retain_as_outcomes_not_missing_or_discarded"
  },
  "required_run_manifest_fields": [
    "run_id",
    "protocol_sha256",
    "tool_name",
    "tool_commit",
    "tool_source_sha256",
    "crate_name",
    "crate_version",
    "crate_source_sha256",
    "features",
    "cargo_lock_sha256",
    "api_universe_sha256",
    "generation_toolchain",
    "execution_toolchain",
    "llvm_version",
    "model_identifier",
    "model_revision_or_unavailable_reason",
    "prompt_sha256",
    "generation_request_cap",
    "generation_token_cap",
    "max_repair_attempts",
    "target_slots",
    "initial_seed_hashes",
    "rng_seeds",
    "afl_version",
    "afl_arguments",
    "sanitizer_settings",
    "worker_limit",
    "core_affinity",
    "budget_worker_seconds",
    "run_start",
    "run_end",
    "worker_statistics",
    "phase_statuses",
    "artifact_hashes"
  ],
  "pre_run_required_fields": [
    "run_id",
    "protocol_sha256",
    "tool_name",
    "tool_commit",
    "tool_source_sha256",
    "crate_name",
    "crate_version",
    "crate_source_sha256",
    "features",
    "cargo_lock_sha256",
    "api_universe_sha256",
    "generation_toolchain",
    "execution_toolchain",
    "llvm_version",
    "prompt_sha256",
    "generation_request_cap",
    "generation_token_cap",
    "max_repair_attempts",
    "target_slots",
    "initial_seed_hashes",
    "rng_seeds",
    "afl_version",
    "afl_arguments",
    "sanitizer_settings",
    "worker_limit",
    "core_affinity",
    "budget_worker_seconds"
  ],
  "new_results_acceptance": "all_fields_validated; artifacts_and_api_mapping_verified; comparative_groups_matched",
  "historical_recounts_acceptance": "diagnostic_only; never_replace_main_claims_without_run_provenance",
  "conditional_impl_definition_counting": "retain publicly named definitions regardless of generator constructibility; obligations checked separately"
